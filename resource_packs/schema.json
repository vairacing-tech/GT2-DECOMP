{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gt2-decomp.local/schemas/resource-pack.schema.json",
  "title": "GT2-DECOMP Resource Pack",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "name",
    "base_disc",
    "files"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "base_disc": {
      "type": "string",
      "const": "gt2_us12_simdisk"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "source"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha1": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
